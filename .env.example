# Copie para ".env" (desenvolvimento local) e preencha.
# Na Vercel, a DATABASE_URL é criada sozinha ao conectar o banco (aba Storage).

# Endereço do banco Postgres (Neon). Na Vercel: Storage > seu banco > .env.local
DATABASE_URL=
# Código pedido na tela de instalação (primeiro acesso) para criar o admin.
# Invente uma frase longa; depois da instalação ele não é mais usado.
CODIGO_INSTALACAO=

# Fotos (aba Fotos): bucket PRIVADO no Cloudflare R2 (plano gratuito: 10 GB).
# Cloudflare > R2 > criar bucket; depois "Manage R2 API Tokens" > token com "Object Read & Write" só nesse bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ASAAS (Pix da aba Compras). Só no servidor: nunca vão para o navegador.
# Chave da API (sandbox nos testes; a de produção só na variável Production da Vercel).
ASAAS_API_KEY=
# Sem ela, usa o sandbox. Produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Webhook (POST /api/oferendas?webhook=asaas): o mesmo texto do campo "Token de autenticação"
# do webhook no painel do ASAAS. Sem ele a rota recusa tudo.
ASAAS_WEBHOOK_TOKEN=

# CPF do Perfil: chave que cifra o CPF no banco (32 letras ou mais, aleatória). Só no servidor.
# Gere uma vez e não troque: trocar deixa ilegíveis os CPFs já guardados. Sem ela, o CPF não grava.
CPF_CHAVE=

# ASAAS, conta B (pagamentos em atraso da aba Geral: mensalidades, doações). Só leitura, sem webhook.
# Chave da API da conta B (sandbox nos testes; a de produção só na variável Production da Vercel).
ASAAS2_API_KEY=
# Sem ela, usa o sandbox. Produção: https://api.asaas.com/v3
ASAAS2_API_URL=

# Notificação de consulta paga do Oráculo (Web Push). Gere o par com `node scripts/vapid.js` (uma vez) e cole as duas.
# Sem elas, o app não oferece "Ativar avisos". Trocar as chaves obriga cada aparelho a ativar de novo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Opcional: contato do remetente (mailto: ou https:). Sem ela, o endereço do app.
VAPID_SUBJECT=
