# Copie para ".env" (desenvolvimento local) e preencha.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# Valores em: Supabase > Project Settings > API (ou "API Keys").

SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Vai para o navegador para o login.
SUPABASE_ANON_KEY=
# Chave de serviço (service_role / secret). SÓ no backend. Nunca publique.
SUPABASE_SERVICE_ROLE_KEY=
