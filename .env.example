# Copie para ".env" (desenvolvimento local) e preencha.
# Na Vercel, a DATABASE_URL é criada sozinha ao conectar o banco (aba Storage).

# Endereço do banco Postgres (Neon). Na Vercel: Storage > seu banco > .env.local
DATABASE_URL=
# Código pedido na tela de instalação (primeiro acesso) para criar o admin.
# Invente uma frase longa; depois da instalação ele não é mais usado.
CODIGO_INSTALACAO=

# Fotos (aba Fotos): bucket PRIVADO no Cloudflare R2 (plano gratuito: 10 GB).
# Cloudflare > R2 > criar bucket; depois "Manage R2 API Tokens" > token com "Object Read & Write" só nesse bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
